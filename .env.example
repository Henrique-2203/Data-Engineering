# Porta HTTP (o Render define automaticamente)
PORT=3000

# Banco Postgres (ex.: Neon gratuito). Se vazio, usa um Postgres embutido (PGlite) salvo em DATA_DIR.
DATABASE_URL=

# Pasta do banco embutido (usado só quando DATABASE_URL está vazio)
DATA_DIR=./data/pglite

# Se definido, só quem souber este código consegue criar conta (bom para restringir aos amigos)
REGISTRATION_CODE=

# Máximo de pessoas por canal de voz (a conexão é P2P, então não exagere)
MAX_VOICE_PEERS=10

# --- TURN (opcional, ajuda quem está em 4G/5G ou redes restritas) ---
# Opção A: Cloudflare Realtime TURN (gratuito até 1000 GB/mês)
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# Opção B: qualquer servidor TURN com usuário/senha fixos (separe URLs por vírgula)
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
