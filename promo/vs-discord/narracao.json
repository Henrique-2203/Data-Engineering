[{"line": "Todo mundo fala que o Discord pesa no PC. Então eu fui medir.", "start": 0.0, "end": 3.71, "words": [["Todo", 0.0, 0.32], ["mundo", 0.32, 0.56], ["fala", 0.56, 0.8], ["que", 0.8, 0.96], ["o", 0.96, 1.04], ["Discord", 1.04, 1.52], ["pesa", 1.52, 1.92], ["no", 1.92, 2.08], ["PC.", 2.08, 2.64], ["Então", 2.64, 2.88], ["eu", 2.88, 3.04], ["fui", 3.04, 3.28], ["medir.", 3.28, 3.71]]}, {"line": "O Discord só aberto, sem call nenhuma: setecentos e sessenta megas de memória.", "start": 3.84, "end": 8.53, "words": [["O", 3.84, 4.0], ["Discord", 4.0, 4.48], ["só", 4.48, 4.72], ["aberto,", 4.72, 5.12], ["sem", 5.12, 5.36], ["call", 5.36, 5.68], ["nenhuma:", 5.68, 6.32], ["setecentos", 6.32, 6.86], ["e", 6.86, 6.98], ["sessenta", 6.98, 7.6], ["megas", 7.6, 8.0], ["de", 8.0, 8.16], ["memória.", 8.16, 8.53]]}, {"line": "Agora o Resenha, em call com quatro amigos, assistindo a transmissão do jogo:", "start": 8.64, "end": 12.27, "words": [["Agora", 8.64, 8.96], ["o", 8.96, 9.04], ["Resenha,", 9.04, 9.6], ["em", 9.6, 9.76], ["call", 9.76, 10.08], ["com", 10.08, 10.24], ["quatro", 10.24, 10.48], ["amigos,", 10.48, 10.8], ["assistindo", 10.8, 11.28], ["a", 11.28, 11.36], ["transmissão", 11.36, 11.84], ["do", 11.84, 12.0], ["jogo:", 12.0, 12.27]]}, {"line": "quatrocentos e vinte e um megas.", "start": 12.52, "end": 14.96, "words": [["quatrocentos", 12.56, 13.14], ["e", 13.14, 13.26], ["vinte", 13.26, 13.58], ["e", 13.58, 13.68], ["um", 13.68, 14.0], ["megas.", 14.0, 14.96]]}, {"line": "E olha a transmissão: rodando lisinha.", "start": 14.75, "end": 17.58, "words": [["E", 14.96, 15.2], ["olha", 15.2, 15.52], ["a", 15.52, 15.6], ["transmissão:", 15.6, 16.24], ["rodando", 16.24, 16.88], ["lisinha.", 16.88, 17.58]]}, {"line": "Quarenta e cinco por cento menos memória, fazendo muito mais.", "start": 17.82, "end": 21.24, "words": [["Quarenta", 17.84, 18.22], ["e", 18.22, 18.34], ["cinco", 18.34, 18.62], ["por", 18.62, 18.74], ["cento", 18.74, 19.04], ["menos", 19.04, 19.36], ["memória,", 19.36, 20.0], ["fazendo", 20.0, 20.56], ["muito", 20.56, 20.8], ["mais.", 20.8, 21.24]]}, {"line": "Resenha é grátis. Chama a galera, o link tá na bio.", "start": 21.36, "end": 24.22, "words": [["Resenha", 21.36, 21.92], ["é", 21.92, 22.0], ["grátis.", 22.0, 22.48], ["Chama", 22.48, 22.8], ["a", 22.8, 22.88], ["galera,", 22.88, 23.28], ["o", 23.28, 23.36], ["link", 23.36, 23.68], ["tá", 23.68, 23.76], ["na", 23.76, 23.92], ["bio.", 23.92, 24.22]]}]