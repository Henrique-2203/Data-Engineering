[{"line": "Eu tava transmitindo meu jogo pros amigos na call", "start": 0.0, "end": 2.34, "words": [["Eu", 0.0, 0.16], ["tava", 0.16, 0.4], ["transmitindo", 0.4, 0.88], ["meu", 0.88, 1.04], ["jogo", 1.04, 1.28], ["pros", 1.28, 1.44], ["amigos", 1.44, 1.76], ["na", 1.76, 2.0], ["call", 2.0, 2.34]]}, {"line": "e toda vez que alguém falava, ouvia a própria voz voltando, atrasada.", "start": 2.51, "end": 6.73, "words": [["e", 2.56, 2.8], ["toda", 2.8, 3.04], ["vez", 3.04, 3.28], ["que", 3.28, 3.44], ["alguém", 3.44, 3.76], ["falava,", 3.76, 4.24], ["ouvia", 4.24, 4.72], ["a", 4.72, 4.8], ["própria", 4.8, 5.12], ["voz", 5.12, 5.44], ["voltando,", 5.44, 6.08], ["atrasada.", 6.08, 6.73]]}, {"line": "Escuta só:", "start": 7.28, "end": 8.03, "words": [["Escuta", 7.28, 7.84], ["só:", 7.84, 8.03]]}, {"line": "Isso é o eco: o som do PC ia pra transmissão, levando junto a voz de todo mundo da call.", "start": 8.32, "end": 13.47, "words": [["Isso", 8.32, 8.64], ["é", 8.64, 8.8], ["o", 8.8, 9.04], ["eco:", 9.04, 9.52], ["o", 9.52, 9.6], ["som", 9.6, 9.84], ["do", 9.84, 10.0], ["PC", 10.0, 10.4], ["ia", 10.4, 10.64], ["pra", 10.64, 10.8], ["transmissão,", 10.8, 11.36], ["levando", 11.36, 11.76], ["junto", 11.76, 12.0], ["a", 12.0, 12.08], ["voz", 12.08, 12.4], ["de", 12.4, 12.56], ["todo", 12.56, 12.72], ["mundo", 12.72, 12.96], ["da", 12.96, 13.2], ["call.", 13.2, 13.47]]}, {"line": "Então a gente resolveu.", "start": 13.76, "end": 14.89, "words": [["Então", 13.76, 14.08], ["a", 14.08, 14.16], ["gente", 14.16, 14.32], ["resolveu.", 14.32, 14.89]]}, {"line": "Agora o app do Resenha manda só o som do jogo, e deixa a call de fora.", "start": 15.04, "end": 18.7, "words": [["Agora", 15.04, 15.28], ["o", 15.28, 15.44], ["app", 15.44, 15.76], ["do", 15.76, 15.84], ["Resenha", 15.84, 16.32], ["manda", 16.32, 16.64], ["só", 16.64, 16.8], ["o", 16.8, 16.88], ["som", 16.88, 17.12], ["do", 17.12, 17.2], ["jogo,", 17.2, 17.52], ["e", 17.52, 17.68], ["deixa", 17.68, 18.0], ["a", 18.0, 18.08], [