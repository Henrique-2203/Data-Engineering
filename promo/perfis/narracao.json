[{"line": "Eu usava outro app de call com os meus amigos, mas lá, ter uma foto diferente em cada servidor era pago.", "start": 0.0, "end": 6.09, "words": [["Eu", 0.0, 0.16], ["usava", 0.16, 0.56], ["outro", 0.56, 0.8], ["app", 0.8, 1.12], ["de", 1.12, 1.28], ["call", 1.28, 1.6], ["com", 1.6, 1.76], ["os", 1.76, 1.92], ["meus", 1.92, 2.08], ["amigos,", 2.08, 2.64], ["mas", 2.64, 2.88], ["lá,", 2.88, 3.28], ["ter", 3.28, 3.52], ["uma", 3.52, 3.68], ["foto", 3.68, 4.0], ["diferente", 4.0, 4.48], ["em", 4.48, 4.64], ["cada", 4.64, 4.88], ["servidor", 4.88, 5.36], ["era", 5.36, 5.68], ["pago.", 5.68, 6.09]]}, {"line": "E eu queria deixar tudo mais com a minha cara.", "start": 6.24, "end": 8.2, "words": [["E", 6.24, 6.4], ["eu", 6.4, 6.48], ["queria", 6.48, 6.8], ["deixar", 6.8, 7.04], ["tudo", 7.04, 7.28], ["mais", 7.28, 7.52], ["com", 7.52, 7.6], ["a", 7.6, 7.76], ["minha", 7.76, 7.92], ["cara.", 7.92, 8.2]]}, {"line": "Até que eu conheci o Resenha.", "start": 8.4, "end": 10.05, "words": [["Até", 8.4, 8.72], ["que", 8.72, 8.88], ["eu", 8.88, 8.96], ["conheci", 8.96, 9.36], ["o", 9.36, 9.44], ["Resenha.", 9.44, 10.05]]}, {"line": "Aqui, em cada servidor, eu posso ter uma foto e um nome diferentes.", "start": 10.27, "end": 14.09, "words": [["Aqui,", 10.32, 10.72], ["em", 10.72, 10.88], ["cada", 10.88, 11.2], ["servidor,", 11.2, 11.68], ["eu", 11.68, 11.84], ["posso", 11.84, 12.16], ["ter", 12.16, 12.32], ["uma", 12.32, 12.56], ["foto", 12.56, 12.8], ["e", 12.8, 12.96], ["um", 12.96, 13.12], ["nome", 13.12, 13.44], ["diferentes.", 13.44, 14.09]]}, {"line": "Na mesa de RPG das sextas, eu sou o Sir Kael, o paladino.", "start": 14.16, "end": 17.72, "words": [["Na", 14.16, 14.32], ["mesa", 14.32, 14.56], ["de", 14.56, 14.64], ["RPG", 14.64, 15.12], ["das", 15.12, 15.28], ["sextas,", 15.28, 15.84], ["eu", 15.84, 15.92], ["sou", 15.92, 16.08], ["o", 16.08, 16.16], ["Sir", 16.16, 16.48], ["Kael,", 16.48, 17.04], ["o", 17.04, 17.12], ["paladino.", 17.12, 17.72]]}, {"line": "Na outra mesa, eu viro o Zéfiro, o mago.", "start": 17.92, "end": 20.29, "words": [["Na", 17.92, 18.08], ["outra", 18.08, 18.32], ["mesa,", 18.32, 18.64], ["eu", 18.64, 18.72], ["viro", 18.72, 18.96], ["o", 18.96, 19.04], ["Zéfiro,", 19.04, 19.76], ["o", 19.76, 19.92], ["mago.", 19.92, 20.29]]}, {"line": "E no grupo da faculdade, sou só o Henrique, do jeito que todo mundo me conhece.", "start": 20.39, "end": 24.25, "words": [["E", 20.4, 20.56], ["no", 20.56, 20.72], ["grupo", 20.72, 20.96], ["da", 20.96, 21.04], ["faculdade,", 21.04, 21.6], ["sou", 21.6, 21.84], ["só", 21.84, 22.08], ["o", 22.08, 22.16], ["Henrique,", 22.16, 22.72], ["do", 22.72, 22.8], ["jeito", 22.8, 23.12], ["que", 23.12, 23.28], ["todo", 23.28, 23.44], ["mundo", 23.44, 23.68], ["me", 23.68, 23.84], ["conhece.", 23.84, 24.25]]}, {"line": "É só abrir \"Meu perfil neste servidor\" e trocar, sem mexer no resto.", "start": 24.4, "end": 28.23, "words": [["É", 24.4, 24.56], ["só", 24.56, 24.8], ["abrir", 24.8, 25.12], ["\"Meu", 25.12, 25.36], ["perfil", 25.36, 25.76], ["neste", 25.76, 26.08], ["servidor\"", 26.08, 26.56], ["e", 26.56, 26.72], ["trocar,", 26.72, 27.2], ["sem", 27.2, 27.44], ["mexer", 27.44, 27.84], ["no", 27.84, 28.0], ["resto.", 28.0, 28.23]]}, {"line": "O Resenha é grátis e tá liberando convites. Entra na lista de espera: o link tá na bio.", "start": 28.4, "end": 32.99, "words": [["O", 28.4, 28.48], ["Resenha", 28.48, 28.88], ["é", 28.88, 29.04], ["grátis", 29.04, 29.36], ["e", 29.36, 29.52], ["tá", 29.52, 29.68], ["liberando", 29.68, 30.16], ["convites.", 30.16, 30.8], ["Entra", 30.8, 31.12], ["na", 31.12, 31.28], ["lista", 31.28, 31.52], ["de", 31.52, 31.6], ["espera:", 31.6, 32.08], ["o", 32.08, 32.16], ["link", 32.16, 32.4], ["tá", 32.4, 32.56], ["na", 32.56, 32.72], ["bio.", 32.72, 32.99]]}]