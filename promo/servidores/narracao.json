[{"line": "Ontem, quinze pessoas chegaram no Resenha num dia só.", "start": 0.0, "end": 3.12, "words": [["Ontem,", 0.0, 0.56], ["quinze", 0.56, 0.96], ["pessoas", 0.96, 1.28], ["chegaram", 1.28, 1.68], ["no", 1.68, 1.84], ["Resenha", 1.84, 2.32], ["num", 2.32, 2.56], ["dia", 2.56, 2.88], ["só.", 2.88, 3.12]]}, {"line": "Agora tem o servidor oficial.", "start": 3.28, "end": 4.82, "words": [["Agora", 3.28, 3.6], ["tem", 3.6, 3.84], ["o", 3.84, 3.92], ["servidor", 3.92, 4.4], ["oficial.", 4.4, 4.82]]}, {"line": "Você entra sozinho, acha a galera pra jogar e fica sabendo das novidades primeiro.", "start": 4.96, "end": 9.2, "words": [["Você", 4.96, 5.28], ["entra", 5.28, 5.6], ["sozinho,", 5.6, 6.08], ["acha", 6.08, 6.4], ["a", 6.4, 6.48], ["galera", 6.48, 6.8], ["pra", 6.8, 6.96], ["jogar", 6.96, 7.28], ["e", 7.28, 7.44], ["fica", 7.44, 7.68], ["sabendo", 7.68, 8.08], ["das", 8.08, 8.24], ["novidades", 8.24, 8.8], ["primeiro.", 8.8, 9.2]]}, {"line": "E tem o Explorar.", "start": 9.27, "end": 10.3, "words": [["E", 9.28, 9.44], ["tem", 9.44, 9.68], ["o", 9.68, 9.84], ["Explorar.", 9.84, 10.3]]}, {"line": "Servidores públicos da comunidade.", "start": 10.43, "end": 12.12, "words": [["Servidores", 10.48, 11.04], ["públicos", 11.04, 11.44], ["da", 11.44, 11.52], ["comunidade.", 11.52, 12.12]]}, {"line": "Por categoria.", "start": 12.16, "end": 13.02, "words": [["Por", 12.16, 12.4], ["categoria.", 12.4, 13.02]]}, {"line": "FPS, RPG, Roblox.", "start": 13.2, "end": 15.57, "words": [["FPS,", 13.2, 14.08], ["RPG,", 14.08, 14.8], ["Roblox.", 14.8, 15.57]]}, {"line": "É só clicar em Entrar.", "start": 15.6, "end": 16.75, "words": [["É", 15.6, 15.76], ["só", 15.76, 15.92], ["clicar", 15.92, 16.24], ["em", 16.24, 16.48], ["Entrar.", 16.48, 16.75]]}, {"line": "Tem um servidor? Deixe ele público, escreve as regras e uma mensagem de boas-vindas pra quem chegar.", "start": 16.96, "end": 21.77, "words": [["Tem", 16.96, 17.2], ["um", 17.2, 17.28], ["servidor?", 17.28, 17.84], ["Deixe", 17.84, 18.24], ["ele", 18.24, 18.48], ["público,", 18.48, 18.88], ["escreve", 18.88, 19.36], ["as", 19.36, 19.44], ["regras", 19.44, 19.76], ["e", 19.76, 19.92], ["uma", 19.92, 20.08], ["mensagem", 20.08, 20.4], ["de", 20.4, 20.48], ["boas-vindas", 20.48, 21.2], ["pra", 21.2, 21.28], ["quem", 21.28, 21.52], ["chegar.", 21.52, 21.77]]}, {"line": "E quando alguém entra, a galera dá oi.", "start": 22.0, "end": 24.08, "words": [["E", 22.0, 22.16], ["quando", 22.16, 22.4], ["alguém", 22.4, 22.72], ["entra,", 22.72, 23.12], ["a", 23.12, 23.28], ["galera", 23.28, 23.6], ["dá", 23.6, 23.84], ["oi.", 23.84, 24.08]]}, {"line": "Resenha.", "start": 24.32, "end": 24.89, "words": [["Resenha.", 24.32, 24.89]]}, {"line": "Gratuito, brasileiro e com gente de verdade.", "start": 25.02, "end": 27.6, "words": [["Gratuito,", 25.12, 25.76], ["brasileiro", 25.76, 26.32], ["e", 26.32, 26.48], ["com", 26.48, 26.72], ["gente", 26.72, 27.04], ["de", 27.04, 27.12], ["verdade.", 27.12, 27.6]]}, {"line": "Falta você.", "start": 27.76, "end": 28.51, "words": [["Falta", 27.76, 28.16], ["você.", 28.16, 28.51]]}]